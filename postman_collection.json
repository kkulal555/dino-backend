{
    "info": {
        "_postman_id": "dino-wallet-service-uuid",
        "name": "Internal Wallet Service",
        "description": "API Collection for the NestJS Internal Wallet Service. Includes Top-up, Spend, Bonus flows with Idempotency and Basic Auth.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "basic",
        "basic": [
            {
                "key": "password",
                "value": "secret",
                "type": "string"
            },
            {
                "key": "username",
                "value": "admin",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "Check Balance",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "http://localhost:3000/wallet/u1/balance?assetId=GOLD",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "3000",
                    "path": [
                        "wallet",
                        "u1",
                        "balance"
                    ],
                    "query": [
                        {
                            "key": "assetId",
                            "value": "GOLD"
                        }
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Get Ledger",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "http://localhost:3000/transactions/ledger/u1?limit=10",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "3000",
                    "path": [
                        "transactions",
                        "ledger",
                        "u1"
                    ],
                    "query": [
                        {
                            "key": "limit",
                            "value": "10"
                        }
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Top-up Wallet",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Idempotency-Key",
                        "value": "key-topup-{{$randomInt}}",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"userId\": \"u1\",\n    \"amount\": \"50\",\n    \"assetId\": \"GOLD\",\n    \"reference\": \"REF-{{$randomInt}}\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "http://localhost:3000/transactions/topup",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "3000",
                    "path": [
                        "transactions",
                        "topup"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Spend Credits",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Idempotency-Key",
                        "value": "key-spend-{{$randomInt}}",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"userId\": \"u1\",\n    \"amount\": \"25\",\n    \"assetId\": \"GOLD\",\n    \"reference\": \"REF-{{$randomInt}}\",\n    \"itemId\": \"ITEM-{{$randomInt}}\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "http://localhost:3000/transactions/spend",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "3000",
                    "path": [
                        "transactions",
                        "spend"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Award Bonus",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Idempotency-Key",
                        "value": "key-bonus-{{$randomInt}}",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"userId\": \"u1\",\n    \"amount\": \"100\",\n    \"assetId\": \"POINTS\",\n    \"reference\": \"REF-{{$randomInt}}\",\n    \"reason\": \"LOYALTY_REWARD\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "http://localhost:3000/transactions/bonus",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "3000",
                    "path": [
                        "transactions",
                        "bonus"
                    ]
                }
            },
            "response": []
        }
    ]
}